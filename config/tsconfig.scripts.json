{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["./scripts/**/*"],
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "composite": false,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["../src/renderer/src/*"]
    }
  }
}
